TWELVEDATA_API_KEY=

# Optional — enables a consensus EPS estimate on every historical quarter of
# the stock page's Earnings charts. Free key (25 req/day): alphavantage.co.
# Without it those charts fall back to actuals with estimates only on the
# most recent ~4 quarters.
ALPHAVANTAGE_API_KEY=

# Optional — the fastest source for a quarter that has just been reported,
# and the only free one carrying a revenue consensus next to the EPS one.
# It also powers Upcoming Events, stock Recent News, and supply-chain
# relationship articles with publisher, summary, date, URL, and image data.
# Free key (60 req/min): finnhub.io. Its earnings tier is shallow (four reported
# quarters and the next few scheduled dates), so it leads on those and the
# feeds above still fill in the years behind them. Without it the Earnings
# cards wait on a scrape of Yahoo's calendar page, which answers a throttled
# request with a consent page and no numbers at all.
FINNHUB_API_KEY=

# Optional — the same recent window as Finnhub, asked only when Finnhub has
# nothing for the symbol. Free key (~250 req/day, 5 rows per symbol, and a
# few symbols are held back as premium): financialmodelingprep.com
FMP_API_KEY=

# Optional — quarterly revenue, net income and diluted EPS straight from SEC
# filings, used only when stockanalysis.com (an undocumented endpoint, and
# the usual source) stops answering. A filing trails the earnings release by
# a week or two, so this is a safety net rather than a live feed.
# Free key (5 req/min): polygon.io
POLYGON_API_KEY=

# Accounts (Auth.js) use a standard PostgreSQL database.
AUTH_SECRET=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lunaterminal

# Optional — Google sign-in. Create your own OAuth credentials at
# https://console.cloud.google.com/apis/credentials (see README "Accounts"
# section for exact steps). The Google button only appears once both are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=


# Lilo AI - the assistant in the bottom-right corner of every page.
#
# OPTIONAL. Lilo also works without it: lib/liloLocal.js answers from this site's
# own data - live quotes, today's market sentiment reading, and a link to any page
# on the site - with no key and no model. Setting a key upgrades it to handle
# open-ended questions and conversational follow-ups; if the key is missing or
# rejected, it silently falls back to the local answers rather than failing.
# Usage is billed per token, so this is the one paid key in the file.
ANTHROPIC_API_KEY=

# Required only if the key above is an organisation key rather than a
# workspace-scoped one - the API rejects the request outright and names this
# header when it is missing. Find the ID in the console URL for the workspace.
# ANTHROPIC_WORKSPACE_ID=

# Optional - which model answers. Defaults to claude-opus-5. Set
# claude-haiku-4-5 for a cheaper, faster tab at some cost in answer quality.
# AI_BOT_MODEL=claude-haiku-4-5

# Semantic news search for the events card and supply-chain evidence.
EXA_API_KEY=

# Market sentiment email alerts. Without RESEND_API_KEY and ALERT_FROM_EMAIL the
# alert cron still runs and records readings, it just sends nothing.
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@yourdomain.com
# A provider-neutral scheduler can send this as a bearer token to
# /api/cron/alerts. An unset value safely disables scheduled runs.
CRON_SECRET=

# Cloudflare Turnstile (bot check on signup); get from the Turnstile dashboard.
TURNSTILE_SECRET_KEY=
TRADIER_API_TOKEN=

# Saved AI chats for signed-in users (/api/chats). Name of the DynamoDB table
# (PK/SK + GSI1, see docs/BACKEND_PLAN.md section 4.4). Unset in `next dev`
# uses an in-memory store; unset in production answers 503 and the browser
# keeps chats locally.
CHAT_TABLE=
